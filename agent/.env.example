# OpenAI 兼容接口（供 Agent 调用）
# 也可使用：http://localhost:5000/compatible-mode/v1
OPENAI_BASE_URL=http://localhost:5000/v1
OPENAI_API_KEY=sk-autobrowser
OPENAI_MODEL=qwen-plus
OPENAI_TEMPERATURE=0.2
# 打印每次 LLM 调用的输入/输出（设为 false 关闭）
LLM_IO_LOG=true

# 禅道 MCP（@zzp123/mcp-zentao 开发工程师版 index-dev）
# 首次使用需通过 initZentao 工具初始化，配置保存在 ~/.zentao/config.json
ZENTAO_MCP_ENABLED=false

# BitBrowser MCP（HTTP）
BITBROWSER_MCP_ENABLED=true
BITBROWSER_MCP_URL=http://127.0.0.1:54345/mcp
