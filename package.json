{
  "name": "developer-assistant",
  "version": "1.1.1",
  "description": "开发者脚本助手",
  "type": "module",
  "main": "backend/dist/index.js",
  "scripts": {
    "start": "node backend/dist/index.js",
    "start:electron": "npm run start --prefix electron",
    "dev": "cross-env DATABASE_DIR=./data/pglite DATA_DIR=./data BACKUP_DIR=./data/db-bak LEGACY_DATABASE_PATH=./data/db.json LOGS_DIR=./logs tsx watch backend/src/index.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:electron": "cross-env NODE_ENV=dev APP_URL=http://localhost:5173 npm run start --prefix electron",
    "dev:agent": "npm run dev --prefix agent",
    "build:agent": "npm run build --prefix agent",
    "agent:demo": "npm run demo --prefix agent",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build:frontend": "npm run build --prefix frontend",
    "build:electron": "npm run build --prefix electron",
    "build:electron:win": "npm run build:win --prefix electron",
    "build:electron:mac": "npm run build:mac --prefix electron",
    "build:electron:linux": "npm run build:linux --prefix electron",
    "move": "npm run build:backend && npm run build:frontend && node scripts/move.mjs",
    "db:generate": "drizzle-kit generate --config backend/drizzle.config.ts",
    "db:push": "drizzle-kit push --config backend/drizzle.config.ts"
  },
  "keywords": [
    "scripts",
    "fastify",
    "developer-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@fastify/static": "^8.0.4",
    "clipboardy": "^5.3.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.2.1",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
